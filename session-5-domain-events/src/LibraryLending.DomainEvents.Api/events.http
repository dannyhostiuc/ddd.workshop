@host = http://localhost:5000

###
GET {{host}}/

### Start a 7-day loan
# @name start
POST {{host}}/loans
Content-Type: application/json

{
  "memberId": "11111111-1111-1111-1111-111111111111",
  "copyId":   "22222222-2222-2222-2222-222222222222",
  "days": 7
}

### See active loans
GET {{host}}/loans

### See fines (none yet)
GET {{host}}/fines

### Advance the clock past the due date — should issue a fine
POST {{host}}/clock/advance
Content-Type: application/json

{ "days": 10 }

### Now there should be a fine
GET {{host}}/fines

### Return the loan
POST {{host}}/loans/{{start.response.body.id}}/return
