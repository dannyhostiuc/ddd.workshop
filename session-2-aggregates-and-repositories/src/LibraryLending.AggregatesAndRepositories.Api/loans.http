@host = http://localhost:5000

###
GET {{host}}/

### Start a new loan
# @name start
POST {{host}}/loans
Content-Type: application/json

{
  "memberId": "11111111-1111-1111-1111-111111111111",
  "copyId":   "22222222-2222-2222-2222-222222222222",
  "startedOn": "2026-04-20",
  "dueOn":     "2026-05-04"
}

### Get the loan
GET {{host}}/loans/{{start.response.body.id}}

### Renew the loan
POST {{host}}/loans/{{start.response.body.id}}/renew

### Return the loan
POST {{host}}/loans/{{start.response.body.id}}/return
Content-Type: application/json

{ "on": "2026-04-25" }
